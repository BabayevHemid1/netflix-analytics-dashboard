          },
          {
            "name": "duration_label",
            "dataType": "string",
            "sourceColumn": "duration_label",
            "summarizeBy": "none",
            "lineageTag": "a82fdddd-2fd6-4b38-af67-54723d4a301f"
          }
        ],
        "partitions": [
          {
