        ],
        "measures": [
          {
            "name": "Total Titles",
            "expression": "DISTINCTCOUNT(Netflix[show_id])",
            "formatString": "#,0",
            "displayFolder": "Göstəricilər",
            "lineageTag": "e3056585-ec61-41b5-9cf5-95187af3b856"
          },
          {
            "name": "Movies",
            "expression": "CALCULATE([Total Titles], KEEPFILTERS(Netflix[type] = \"Movie\"))",
            "formatString": "#,0",
            "displayFolder": "Göstəricilər",
            "lineageTag": "60efaa8c-b564-4623-9a11-8b0bdc49ca6f"
          },
          {
            "name": "Series",
            "expression": "CALCULATE([Total Titles], KEEPFILTERS(Netflix[type] = \"TV Show\"))",
            "formatString": "#,0",
            "displayFolder": "Göstəricilər",
            "lineageTag": "4f6e6a06-b530-4e04-ab17-ed62b5778ea7"
          },
          {
            "name": "Movie Share",
            "expression": "DIVIDE([Movies], [Total Titles])",
            "formatString": "0.0%",
            "displayFolder": "Göstəricilər",
            "lineageTag": "1fd45fe7-1543-46c5-a36f-082c16b62879"
          },
          {
            "name": "Series Share",
            "expression": "DIVIDE([Series], [Total Titles])",
            "formatString": "0.0%",
            "displayFolder": "Göstəricilər",
            "lineageTag": "070a647b-75e8-4994-94db-1fdfad31ac78"
          },
          {
            "name": "Countries",
            "expression": "CALCULATE(DISTINCTCOUNT(Countries[country]), Countries[country] <> \"Məlumat yoxdur\")",
            "formatString": "#,0",
            "displayFolder": "Göstəricilər",
            "lineageTag": "1b4e02a4-2d5c-46c5-93b8-4df019de4cc5"
          },
          {
            "name": "Genre Count",
            "expression": "DISTINCTCOUNT(Genres[genre])",
            "formatString": "#,0",
            "displayFolder": "Göstəricilər",
            "lineageTag": "9959b0a4-15f4-44be-a05f-82465d9536d5"
          },
          {
            "name": "Avg Movie Minutes",
            "expression": "CALCULATE(AVERAGE(Netflix[duration]), KEEPFILTERS(Netflix[type] = \"Movie\"))",
            "formatString": "0.0\" dəq.\"",
            "displayFolder": "Göstəricilər",
            "lineageTag": "ecf4adb2-69aa-4327-b638-9a07528f871c"
          },
          {
            "name": "Avg Seasons",
            "expression": "CALCULATE(AVERAGE(Netflix[duration]), KEEPFILTERS(Netflix[type] = \"TV Show\"))",
            "formatString": "0.0",
            "displayFolder": "Göstəricilər",
            "lineageTag": "e36813ec-aa6f-4775-843c-b2a18b47230c"
          },
          {
            "name": "Missing Country",
            "expression": "CALCULATE([Total Titles], KEEPFILTERS(Netflix[country] = \"Məlumat yoxdur\"))",
            "formatString": "#,0",
            "displayFolder": "Göstəricilər",
            "lineageTag": "2d9cb91e-2057-4cee-b003-008901906ce1"
          },
          {
            "name": "Missing Added Date",
            "expression": "CALCULATE([Total Titles], KEEPFILTERS(ISBLANK(Netflix[date_added])))",
            "formatString": "#,0",
            "displayFolder": "Göstəricilər",
            "lineageTag": "abd96734-0fdc-4858-bc94-65f1a614d3b3"
          },
          {
            "name": "Country Rank",
            "expression": "RANKX(FILTER(ALLSELECTED(Countries[country]), Countries[country] <> \"Məlumat yoxdur\"), [Total Titles], , DESC, DENSE)",
            "formatString": "0",
            "displayFolder": "Göstəricilər",
            "lineageTag": "58bb4b75-0799-44a2-9d11-269c4c6d66b0"
          },
          {
            "name": "Genre Rank",
            "expression": "RANKX(ALLSELECTED(Genres[genre]), [Total Titles], , DESC, DENSE)",
            "formatString": "0",
            "displayFolder": "Göstəricilər",
            "lineageTag": "416d4408-03e3-44a0-8500-5f275ee62511"
          }
        ]
      },
      {
        "name": "Countries",
        "lineageTag": "f7e7a6f3-e997-43e8-8439-f7e848e78227",
