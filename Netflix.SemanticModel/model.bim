{
  "name": "Netflix",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "expressions": [
      {
        "name": "NetflixSource",
        "kind": "m",
        "expression": [
          "let",
          "    Raw = Csv.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.GZip), [Delimiter=\",\", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),",
          "    Types = Table.TransformColumnTypes(Headers, {{\"release_year\", Int64.Type}, {\"duration\", Int64.Type}}),",
          "    Dates = Table.TransformColumns(Types, {{\"date_added\", each if _ = null or Text.Trim(_) = \"\" then null else try Date.FromText(Text.Trim(_), [Culture=\"en-US\"]) otherwise null, type date}}),",
          "    Filled = Table.TransformColumns(Dates, List.Transform({\"country\", \"director\", \"cast\", \"rating\"}, (c) => {c, each if _ = null or Text.Trim(_) = \"\" then \"Məlumat yoxdur\" else Text.Trim(_), type text})),",
          "    AddedYear = Table.AddColumn(Filled, \"added_year\", each if [date_added] = null then null else Date.Year([date_added]), Int64.Type),",
          "    ContentType = Table.AddColumn(AddedYear, \"content_type\", each if [type] = \"Movie\" then \"Film\" else \"Serial\", type text),",
          "    DurationLabel = Table.AddColumn(ContentType, \"duration_label\", each Text.From([duration]) & (if [type] = \"Movie\" then \" dəq.\" else \" mövsüm\"), type text)",
          "in",
          "    DurationLabel"
        ]
      }
    ],
    "tables": [
      {
        "name": "Netflix",
        "lineageTag": "cc88a1d5-ae71-4266-acdd-419a264fe8d7",
