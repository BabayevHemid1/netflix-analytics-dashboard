            "lineageTag": "25201929-0c7d-49b8-aae1-12975a6bbb52"
          }
        ],
        "partitions": [
          {
            "name": "Countries",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.SelectColumns(NetflixSource, {\"show_id\", \"country\"}),",
                "    Lists = Table.TransformColumns(Source, {{\"country\", each List.Transform(Text.Split(_, \",\"), Text.Trim)}}),",
                "    Expanded = Table.ExpandListColumn(Lists, \"country\"),",
                "    Unique = Table.Distinct(Expanded),",
                "    Types = Table.TransformColumnTypes(Unique, {{\"show_id\", type text}, {\"country\", type text}})",
                "in",
                "    Types"
              ]
            }
          }
        ]
      },
      {
        "name": "Genres",
        "lineageTag": "41f6ec82-e236-4223-ad4b-4cb8de43b7ce",
        "columns": [
          {
            "name": "show_id",
            "dataType": "string",
            "sourceColumn": "show_id",
            "summarizeBy": "none",
            "lineageTag": "d0f22bad-9444-411d-8c77-8dcf76453cd4",
            "isHidden": true
          },
          {
            "name": "genre",
            "dataType": "string",
            "sourceColumn": "genre",
            "summarizeBy": "none",
            "lineageTag": "eaf9f061-4460-4956-b867-55adc2de06a3"
          }
        ],
        "partitions": [
          {
            "name": "Genres",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.SelectColumns(NetflixSource, {\"show_id\", \"genres\"}),",
                "    Lists = Table.TransformColumns(Source, {{\"genres\", each List.Transform(Text.Split(_, \",\"), Text.Trim)}}),",
                "    Expanded = Table.ExpandListColumn(Lists, \"genres\"),",
                "    Unique = Table.Distinct(Expanded),",
                "    Types = Table.TransformColumnTypes(Unique, {{\"show_id\", type text}, {\"genres\", type text}})",
                "in",
                "    Table.RenameColumns(Types, {{\"genres\", \"genre\"}})"
              ]
            }
          }
        ]
      }
    ],
